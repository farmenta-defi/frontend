# WalletConnect Cloud project id (free: https://cloud.reown.com).
# Injected wallets work without it; WalletConnect QR needs a real id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional RPC override (e.g. Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/<KEY>).
# Default is the official public RPC (some ISPs DNS-hijack it).
NEXT_PUBLIC_RPC_URL=

# The backend the displayed figures come from: APY, utilisation, TVL, each pool's terms and
# debt, and the charts. Public, so never a URL with a key in it; the paid RPC stays on the
# backend. Left empty, the pages open and say that there are no figures; the on-chain actions
# work either way. Production: https://api-farmenta.103-127-134-131.nip.io
NEXT_PUBLIC_API_URL=

# Which address manifest in deployments/ the app talks to (deployments/<name>.json, the
# output of smart-contract's script/manifest.sh, copied unchanged). Leave empty while
# nothing is deployed: the app builds and the action buttons are disabled.
NEXT_PUBLIC_FARMENTA_DEPLOYMENT=

# Only for `pnpm fork`. The list of a wallet's positions is read from the chain's logs, from
# PositionManager's deployment to now, through the chain's public RPC: a free-tier provider
# key refuses a range of more than 10 blocks. On a fork the logs are on the fork and start at
# its block; `pnpm fork` prints the two values.
NEXT_PUBLIC_LOGS_RPC_URL=
NEXT_PUBLIC_LOGS_FROM_BLOCK=
